{
  "database": {
    "path": "./gtfs.sqlite",
    "durability": "safe"
  },
  "reporting": {
    "level": "info"
  },
  "extensions": ["gtfs-realtime"],
  "sources": [
    {
      "sourceId": "remote-transit",
      "schedule": {
        "url": "https://example.com/remote-feed/gtfs.zip",
        "requestHeaders": {
          "Authorization": "Bearer replace-with-your-token"
        },
        "timeoutMs": 60000,
        "excludeFiles": ["shapes.txt"],
        "defaultAgencyId": "remote-transit",
        "import": {
          "archive": {
            "maxCompressedBytes": 1073741824,
            "maxEntries": 1000,
            "maxExtractedFileBytes": 4294967296,
            "maxExtractedTotalBytes": 8589934592
          },
          "csv": {
            "delimiter": ",",
            "encoding": "utf8",
            "escape": "\"",
            "quote": "\"",
            "relaxQuotes": true,
            "skipEmptyLines": true,
            "trim": true
          },
          "onExistingData": "replace-source",
          "onSourceError": "abort",
          "validation": {
            "mode": "off",
            "onDuplicateKey": "reject",
            "onUnknownField": "preserve"
          }
        }
      },
      "realtime": {
        "feeds": [
          {
            "feedId": "bus-alerts",
            "type": "alerts",
            "url": "https://example.com/realtime/bus-alerts",
            "requestHeaders": {
              "Authorization": "Bearer replace-with-your-token"
            },
            "timeoutMs": 30000,
            "maxDownloadBytes": 67108864
          },
          {
            "feedId": "rail-alerts",
            "type": "alerts",
            "url": "https://example.com/realtime/rail-alerts",
            "requestHeaders": {
              "Authorization": "Bearer replace-with-your-token"
            },
            "timeoutMs": 30000,
            "maxDownloadBytes": 67108864
          },
          {
            "type": "tripUpdates",
            "url": "https://example.com/realtime/trip-updates",
            "requestHeaders": {
              "Authorization": "Bearer replace-with-your-token"
            },
            "timeoutMs": 30000,
            "maxDownloadBytes": 67108864
          },
          {
            "type": "vehiclePositions",
            "url": "https://example.com/realtime/vehicle-positions",
            "requestHeaders": {
              "Authorization": "Bearer replace-with-your-token"
            },
            "timeoutMs": 30000,
            "maxDownloadBytes": 67108864
          }
        ]
      }
    },
    {
      "sourceId": "local-transit",
      "schedule": {
        "path": "./data/local-gtfs.zip"
      }
    }
  ],
  "realtime": {
    "retention": {
      "currentEntitiesSeconds": 30,
      "snapshotsSeconds": 86400
    }
  },
  "export": {
    "batchSize": 1000,
    "outputDirectory": "./gtfs-export",
    "overwrite": false,
    "sourceId": "remote-transit"
  }
}
