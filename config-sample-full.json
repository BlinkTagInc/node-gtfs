{
  "agencies": [
    {
      "url": "https://example.com/remote-feed/gtfs.zip",
      "headers": {
        "Authorization": "Bearer replace-with-your-token"
      },
      "prefix": "remote",
      "exclude": ["shapes"],
      "fillEmptyAgencyId": true,
      "agencyId": "remote-transit",
      "realtimeAlerts": {
        "url": "https://example.com/remote-feed/alerts.pb",
        "headers": {
          "Authorization": "Bearer replace-with-your-token"
        }
      },
      "realtimeTripUpdates": {
        "url": "https://example.com/remote-feed/trip-updates.pb",
        "headers": {
          "Authorization": "Bearer replace-with-your-token"
        }
      },
      "realtimeVehiclePositions": {
        "url": "https://example.com/remote-feed/vehicle-positions.pb",
        "headers": {
          "Authorization": "Bearer replace-with-your-token"
        }
      }
    },
    {
      "path": "./data/local-gtfs.zip",
      "prefix": "local"
    }
  ],
  "csvOptions": {
    "bom": true,
    "skip_empty_lines": true
  },
  "downloadTimeout": 60000,
  "exportPath": "./gtfs-export",
  "gtfsRealtimeExpirationSeconds": 3600,
  "ignoreDuplicates": false,
  "ignoreErrors": false,
  "includeImportReport": false,
  "logLevel": "info",
  "sqlitePath": "./gtfs.sqlite"
}
