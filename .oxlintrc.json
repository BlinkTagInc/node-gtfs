{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Arrays are preallocated by length on hot import paths on purpose.
    "unicorn/no-new-array": "off"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["dist"]
}
