  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "gtfs-export": "dist/bin/gtfs-export.js",
    "gtfs-import": "dist/bin/gtfs-import.js",
    "gtfsrealtime-update": "dist/bin/gtfsrealtime-update.js"
  },
  "scripts": {
    "build": "tsdown",
    "build-watch": "tsdown --watch",
    "test": "pnpm run build && node --test --test-reporter=spec src/test/**/*.test.ts",
    "typecheck": "pnpm run build && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node .husky/install.mjs",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/models.d.ts",
      "default": "./dist/models/models.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@turf/helpers": "7.4.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "gtfs-realtime-bindings": "2.2.0",
    "kysely": "0.29.5",
    "lodash-es": "4.18.1",
    "long": "5.3.2",
    "node-stream-zip": "1.16.0",
    "sanitize-filename": "1.6.4",
    "yoctocolors": "2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/geojson": "7946.0.16",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxlint": "1.78.0",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    },
    "hooks": {
      "after:bump": "pnpm run build"
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.js": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.json": "prettier --write"
  },
  "packageManager": "pnpm@11.21.0"
}
